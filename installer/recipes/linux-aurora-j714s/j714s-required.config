CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_DART=y
CONFIG_BTRFS_FS=m
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=m
CONFIG_VFAT_FS=y
CONFIG_DRM_ASAHI=y
CONFIG_GPIO_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_APPLE_CENTAURI=m
CONFIG_POWER_RESET_MACSMC=m
CONFIG_MACSMC_POWER=y
CONFIG_DM_INTEGRITY=m
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_AOP=m
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
# edimoldovan omarchy-mac-pkgs 74d8f8bbef: lets kernel.sched_util_clamp_min_rt_default=0 stop
# realtime threads (PipeWire) holding the P clusters at top speed
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
# AOP sensors: lid angle and ambient light (DjDeveloperr #1542/#1548)
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
# USB 2.0 host PHY on ports 0 and 2 (edimoldovan J714c)
# macOS 27.2 Mach-O Stage 1: the kernel runs inside Aura's CTXR execute window (spin-table CPUs)
CONFIG_ARM64_CTXR_EXECMEM=y
# DisplayPort audio over USB-C (#1748/#1749/#1750) and the J714s speakers (#1554)
CONFIG_APPLE_ADMAC=m
CONFIG_SND_SOC_APPLE_T8152_AOP_AUDIO=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m
# chrisohearn, betizzel/omarchy-m5#9: Bluetooth hands-free/headset profiles (RFCOMM) and iwd's
# pkcs8_key_parser for certificate (enterprise) Wi-Fi
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
# chrisohearn, betizzel/omarchy-m5#14: options that a tool failed without on a K114s (journal lines
# in the PR). Only what a tool asks for is pinned here; the rest of the same change is in config.
# bluetoothd: "kernel lacks bnep-protocol support" (Bluetooth network access, phone tethering)
CONFIG_BT_BNEP=m
# tailscaled: "error querying IP rules (does kernel have IP_MULTIPLE_TABLES?)"
CONFIG_IP_MULTIPLE_TABLES=y
# tailscaled: "disabling tunneled IPv6 ... kernel doesn't support IPv6 policy routing"
CONFIG_IPV6_MULTIPLE_TABLES=y
# tailscaled's connmark rules: "Extension CONNMARK revision 0 not supported"
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
# tailscaled's packet-mark rules (the front ends of xt_mark, which the base left off)
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
# tailscaled's "-m mark ... -j MASQUERADE" (RULE_APPEND failed); also Docker's default bridge
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
# Omarchy's 99-omarchy-sysctl.conf: tcp_congestion_control=bbr (needs TCP_CONG_ADVANCED, set in config)
CONFIG_TCP_CONG_BBR=m
# Omarchy's 99-omarchy-sysctl.conf: default_qdisc=fq
CONFIG_NET_SCH_FQ=m
# systemd's own default_qdisc (50-default.conf)
CONFIG_NET_SCH_FQ_CODEL=m
