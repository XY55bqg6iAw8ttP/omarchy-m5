From: chrisohearn <chrisohearn@users.noreply.github.com>
Subject: [PATCH] output: treat degenerate EDID primaries as missing

The edid colour preset takes the monitor's EDID chromaticity coordinates
whenever the base block has them, and aquamarine always fills them from the
base block. A sink that sends zero red, green and blue primaries (the M5 Pro
OLED MacBook's display controller on firmware 27.2 does, aurora-silicon/linux
#2060) gets an image description whose primaries matrix is singular: the
inverse is NaN, and the final colour-management pass writes every frame black
while the panel keeps presenting (betizzel/omarchy-m5#21).

Treat the EDID primaries as missing when any red, green, blue or white point
has y <= 0 or a coordinate that is not finite, or when the red, green and
blue points span no triangle. The edid preset then falls back to sRGB, as it
already does for an EDID without primaries, with a warning in the log; the
HDR edid preset falls back to BT.2020 primaries, and the mastering primaries
handed to clients are left empty. Valid primaries are used as before.

Base: Hyprland v0.57.2, after the recipe's nvidia-egl-teardown,
wl-output-global-grace, monitor-rule-vrr, 0001 and 0002 patches.

---
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -63,6 +63,7 @@
 #include <hyprutils/utils/ScopeGuard.hpp>
 #include <cstring>
 #include <climits>
+#include <cmath>
 #include <optional>
 #include <ranges>
 #include <vector>
@@ -515,6 +516,24 @@
     }
 }
 
+// EDID primaries describe a colour space only when every point has y > 0 and the red, green
+// and blue points span a triangle. Some sinks send zeros instead (the M5 Pro OLED MacBook's
+// display controller on firmware 27.2 does): built into a conversion matrix, they invert to
+// NaN, and the final colour-management pass writes every frame black.
+static bool usableEDIDPrimaries(const std::optional<Aquamarine::IOutput::SChromaticityCoords>& coords) {
+    if (!coords.has_value())
+        return false;
+
+    const auto& c = *coords;
+    for (const auto& p : {c.red, c.green, c.blue, c.white}) {
+        if (!std::isfinite(p.x) || !std::isfinite(p.y) || p.y <= 0.0)
+            return false;
+    }
+
+    const double area = (c.green.x - c.red.x) * (c.blue.y - c.red.y) - (c.green.y - c.red.y) * (c.blue.x - c.red.x);
+    return std::isfinite(area) && std::abs(area) > 1e-6;
+}
+
 void CMonitor::applyCMType(NCMType::eCMType cmType, NTransferFunction::eTF cmSdrEotf) {
     // SDR presets must not carry EDID HDR metadata, or clients see headroom an SDR transfer function can't encode
     const bool                                                        hdrPreset           = cmType == NCMType::CM_HDR || cmType == NCMType::CM_HDR_EDID;
@@ -610,7 +629,11 @@
         m_cmType = m_activeMonitorRule.m_cmType;
         switch (m_cmType) {
             case NCMType::CM_AUTO: m_cmType = m_enabled10bit && supportsWideColor() ? NCMType::CM_WIDE : NCMType::CM_SRGB; break;
-            case NCMType::CM_EDID: m_cmType = m_output->parsedEDID.chromaticityCoords.has_value() ? NCMType::CM_EDID : NCMType::CM_SRGB; break;
+            case NCMType::CM_EDID:
+                if (m_output->parsedEDID.chromaticityCoords.has_value() && !usableEDIDPrimaries(m_output->parsedEDID.chromaticityCoords))
+                    LOG(Log::WARN, "Monitor {}: the EDID primaries are degenerate, using sRGB instead of the edid preset", m_name);
+                m_cmType = usableEDIDPrimaries(m_output->parsedEDID.chromaticityCoords) ? NCMType::CM_EDID : NCMType::CM_SRGB;
+                break;
             case NCMType::CM_HDR:
             case NCMType::CM_HDR_EDID: m_cmType = supportsHDR() ? m_cmType : NCMType::CM_SRGB; break;
             default: break;
@@ -2420,7 +2443,7 @@
 }
 
