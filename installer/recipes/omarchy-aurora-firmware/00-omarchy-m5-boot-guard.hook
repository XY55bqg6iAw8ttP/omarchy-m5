# The M5 boot packages must stay M5 builds (betizzel/omarchy-m5#11, #12). The image pins them
# with IgnorePkg in /etc/pacman.conf, but an Omarchy channel switch, `omarchy refresh pacman` and
# `omarchy reinstall` copy a template over that file and then run pacman -Syyuu, which would put
# the channel's generic kernel, m1n1 and U-Boot (no M5 device tree) in their place. This hook
# lives outside /etc/pacman.conf, so it still stops that transaction. 00- runs it first.
# The board comes from the device tree's compatible (J714s, K114s); see m5-boot-guard.
[Trigger]
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux-aurora
Target = m1n1-aurora
Target = uboot-aurora
Target = omarchy-aurora-firmware

[Action]
Description = Checking that the M5 boot packages stay M5 builds...
When = PreTransaction
Exec = /usr/lib/omarchy-aurora/m5-boot-guard packages
NeedsTargets
AbortOnFail
