+class FirmwareRebuildTests(unittest.TestCase):
+    """The firmware rebuild path matches the installed macOS version to a row."""
+
+    def test_a_k114s_takes_the_26b8125_row_and_a_j714s_the_26b123_row(self):
+        for board, long_version in (("k114sap", "26.2.125.8.0,0"), ("j714sap", "26.2.123.0.0,0")):
+            with self.subTest(board=board):
+                ipsw = installed_ipsw(IPSW_VERSIONS, SimpleNamespace(device_class=board), "27.2")
+                self.assertEqual((ipsw.version, ipsw.min_sfr, ipsw.devices),
+                                 ("27.2", long_version, [board]))
+
+    def test_the_patch_uses_it_where_the_install_is_matched_by_version(self):
+        main = PATCH.read_text().split("diff --git a/src/main.py")[1].split("diff --git")[0]
+        self.assertIn("+        ipsw = omarchy_firmware.installed_ipsw("
+                      "IPSW_VERSIONS, self.sysinfo, osi.version)\n", main)
+        self.assertIn("-        for ver in IPSW_VERSIONS:\n", main)
+
+    def test_an_unrestricted_row_still_matches_and_a_foreign_board_gets_none(self):
+        self.assertEqual(installed_ipsw(
+            IPSW_VERSIONS, SimpleNamespace(device_class="j313ap"), "13.5").version, "13.5")
+        self.assertIsNone(installed_ipsw(
+            IPSW_VERSIONS, SimpleNamespace(device_class="j700ap"), "27.2"))
+
+
