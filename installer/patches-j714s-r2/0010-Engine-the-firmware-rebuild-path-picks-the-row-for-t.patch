diff --git a/Engine/overlay/src/omarchy_firmware.py b/Engine/overlay/src/omarchy_firmware.py
index 3338662..76a43c1 100644
--- a/Engine/overlay/src/omarchy_firmware.py
+++ b/Engine/overlay/src/omarchy_firmware.py
@@ -72,6 +72,22 @@ def available_ipsws(
     return minver, avail
 
 
+def installed_ipsw(ipsw_versions, sysinfo, version):
+    """The first firmware row for an installed macOS version this Mac may use, or None.
+
+    A device-restricted row is another board's firmware: the J714s's 26B123
+    and the K114s's 26B8125 are both 27.2.
+    """
+    return next(
+        (
+            ipsw for ipsw in ipsw_versions
+            if ipsw.version == version
+            and (ipsw.devices is None or sysinfo.device_class in ipsw.devices)
+        ),
+        None,
+    )
+
+
