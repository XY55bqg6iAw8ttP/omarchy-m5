+    def _j714c(self):
+        installer, files = fixture()
+        installer.sysinfo.device_class = 'j714cap'
+        installer.sysinfo.board_id = 0x0A
+        installer.sysinfo.dt = {'target-type': b'J714c\0'}
+        installer.identity['ApBoardID'] = '0x0A'
+        installer.identity['Info']['DeviceClass'] = 'j714cap'
+        prefix = 'Firmware/Manifests/restore/macOS Customer/centauri/centauri.'
+        files[prefix + 'j714cap.im4m'] = files.pop(prefix + 'j714sap.im4m')
+        return installer, files
+
+    def test_j714c_tickets_its_own_identity(self):
+        installer, files = self._j714c()
+        name, output = c.prepare(installer)
+        self.assertEqual(name, 'apple/centauri/j714c-ftab.bin')
+        self.assertEqual(output[len(files['Firmware/ftab.bin']):],
+                         files['Firmware/Manifests/restore/macOS Customer/centauri/centauri.j714cap.im4m'])
+        self.assertEqual(set(installer.reads), set(files))
+
+    def test_j714c_with_another_board_id_rejects_before_firmware_reads(self):
+        for board in (0x08, 0x0C, 0x14):
+            installer, _ = self._j714c()
+            installer.sysinfo.board_id = board
+            with self.subTest(board=board), self.assertRaises(c.CentauriError):
+                c.prepare(installer)
+            self.assertEqual(installer.reads, [])
+
