+    def _j714c_payload(self, stage2=b"aura ctxr stage2 j714c", drop=()):
+        raw = j700_stage1()
+        with zipfile.ZipFile(self.payload) as archive:
+            entries = {name: archive.read(name) for name in archive.namelist()}
+        entries["esp/aurora/stage1-j714s.bin"] = raw
+        entries["esp/aurora/stage1-j714s.macho"] = aura_macho(raw)
+        entries["esp/m1n1/boot-ctxr.bin"] = stage2
+        for name in drop:
+            entries.pop(name)
+        with zipfile.ZipFile(self.payload, "w") as archive:
+            for name, data in entries.items():
+                archive.writestr(name, data)
+        for name, data in entries.items():
+            if name.startswith("esp/"):
+                path = self.installed_esp / name[len("esp/"):]
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_bytes(data)
+        return raw
+
+    def _j714c_metadata(self, policy=None, allowed=("j714cap",)):
+        metadata = self._target_metadata()
+        metadata["allowed_device_classes"] = list(allowed)
+        metadata["aurora_stage1"] = self.J714C_POLICY if policy is None else policy
+        metadata["recovery_gui"] = "omarchy-native-v1"
+        self._write_metadata([metadata])
+
+    def _j714c_installer(self, ipsw="27.2", device_class="j714cap"):
+        installer = FakeInstaller(FakeDiskUtil([[self.free]]))
+        installer.sysinfo = SimpleNamespace(device_class=device_class, sys_firmware="mBoot-20457.60.77.501.2")
+        installer.ipsw.version = ipsw
+        return installer
+
