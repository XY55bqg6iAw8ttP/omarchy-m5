From 3010fdadd82cd54776b5fe284df226737066a8e9 Mon Sep 17 00:00:00 2001
From: Julian Arango <95070226+ja-818@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:46:25 -0500
Subject: [PATCH 23/24] media: apple: isp: IMX958 setfile named by the board

omarchy-m5's T6050 path runs the IMX958 on setfile 2226_02 (the J714s's
tuning) on every board. The J716s's IMX958 runs 2224_01, as macOS's
appleh16camerad carries for it and as upstream picks for the IMX958.
Let a board's tree name it (apple,imx958-setfile = <0x2224> or <0x2226>),
keeping the SoC's default otherwise, and allow an override
(apple_isp.imx958_setfile=) for A/B tests.

Seen on one J716s (27.2 stub): with 2224_01 the front camera streams
1920x1080 with the indicator light on.

Signed-off-by: Julian Arango <95070226+ja-818@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/apple/isp/isp-cam.c |  8 +++++++-
 drivers/media/platform/apple/isp/isp-drv.c | 21 +++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-drv.h |  2 ++
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 18cd0d7..d4960cb 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -186,7 +186,13 @@ static int isp_ch_get_sensor_id(struct apple_isp *isp, u32 ch)
 		 * Section 0x50f of 2224 and 2226 names sensor 0x958; 2924's
 		 * names 0x614.
 		 */
-		id = isp->hw->imx958_2226 ? ISP_IMX958_2226_02 : ISP_IMX958_2224_01;
+		if (isp->imx958_setfile == 0x2224)
+			id = ISP_IMX958_2224_01;
+		else if (isp->imx958_setfile == 0x2226)
+			id = ISP_IMX958_2226_02;
+		else
+			id = isp->hw->imx958_2226 ? ISP_IMX958_2226_02 :
+						    ISP_IMX958_2224_01;
 		break;
 	case 0xd56:
 		id = ISP_VD56G0_6221_01;
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index c7f7554..63010d5 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -553,6 +553,11 @@ static int apple_isp_init_presets(struct apple_isp *isp)
 /* Preview only; processing and image quality need separate qualification. */
 static bool preview_26 = true;
 module_param(preview_26, bool, 0400);
+
+/* Only for trying the other IMX958 tuning on a board: 0x2224 or 0x2226 */
+static unsigned int imx958_setfile;
+module_param(imx958_setfile, uint, 0400);
+MODULE_PARM_DESC(imx958_setfile, "IMX958 setfile: 0x2224 (2224_01) or 0x2226 (2226_02); default: the device tree's, else the SoC's");
 MODULE_PARM_DESC(preview_26, "Enable J613 preview on ISP firmware 26.6.2 (default: true; false disables)");
 
 static const char * isp_fw2str(enum isp_firmware_version version)
@@ -744,6 +749,22 @@ static int apple_isp_probe(struct platform_device *pdev)
 	of_property_read_u32(dev->of_node, "apple,cam-connections-scheme",
 			     &isp->cam_connections_scheme);
 
+	/*
+	 * macOS picks the IMX958's setfile by camera module, and modules differ
+	 * between boards of one SoC: a board's device tree names its own.
+	 */
+	if (imx958_setfile)
+		isp->imx958_setfile = imx958_setfile;
+	else
+		of_property_read_u32(dev->of_node, "apple,imx958-setfile",
+				     &isp->imx958_setfile);
+	if (isp->imx958_setfile && isp->imx958_setfile != 0x2224 &&
+	    isp->imx958_setfile != 0x2226) {
+		dev_warn(dev, "unknown IMX958 setfile %#x, using the default\n",
+			 isp->imx958_setfile);
+		isp->imx958_setfile = 0;
+	}
+
 	err = apple_isp_init_presets(isp);
 	if (err) {
 		dev_err(dev, "failed to initialize presets\n");
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 82392cb..8637448 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -374,6 +374,8 @@ struct apple_isp {
 	u32 platform_id;
 	u32 temporal_filter;
 	u32 cam_connections_scheme;
+	/* The IMX958 setfile the board names (0x2224 or 0x2226), 0 for the SoC's default */
+	u32 imx958_setfile;
 	struct isp_preset *presets;
 	int num_presets;
 	/* Read-only sensor configuration replies, cached before video registration. */
-- 
2.56.0

