From 5ef09831908e4297d8aa1012a0191c95babde920 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 14 Nov 2026 18:49:45 -0500
Subject: [PATCH 2/3] drm/asahi: g17: give back the pool pages of kept render
 graphs

A render graph stays allocated after its queue is released, until the GPU
firmware is stopped, when the queue's work list still links work. Such a
graph also kept its render pool with all of the pool's pages, mapped in
the address window that every client's pools share. Each one took the
room of a whole pool until then, so repeated failures in one session
could use the window up; new render work would then wait for room and
fail, and the client would see a lost device. This has not been seen in
normal use.

Give those pages back from the worker's housekeeping pass. The pool of a
kept graph is never staged again; its pages go back once its final
free-list release is consumed. The graph and the pool's identity stay as
before.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit 3ad9af366a7251892f3ad9ecca21b086de834ddf)
---
 drivers/gpu/drm/asahi/g17/runtime/render.rs | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g17/runtime/render.rs b/drivers/gpu/drm/asahi/g17/runtime/render.rs
index a725381da5ad..d984e3f0a2ca 100644
--- a/drivers/gpu/drm/asahi/g17/runtime/render.rs
+++ b/drivers/gpu/drm/asahi/g17/runtime/render.rs
@@ -1125,9 +1125,9 @@ fn shrink_pair(
 
     /// Gives back the USC backing of render pools whose client VM pressure
     /// reclaim evicted (an idle VM) and whose final free-list release was
-    /// consumed. The vacated backings go to the worker's deferred batch, which
-    /// frees them after the device mutex; a later job of that client re-arms
-    /// the pool first.
+    /// consumed, and of the pools that kept graphs still hold. The vacated
+    /// backings go to the worker's deferred batch, which frees them after the
+    /// device mutex; a later job of an evicted client re-arms its pool first.
     pub(in crate::g17) fn vacate_evicted_render_pools(
         &mut self,
         init: &crate::g17::initdata::InitData,
@@ -1152,6 +1152,20 @@ pub(in crate::g17) fn vacate_evicted_render_pools(
                 deferred.defer_render_backing(backing);
             }
         }
+        // A kept graph's pool is never staged again; its pages go back once
+        // its final free-list release is consumed.
+        for graph in render.kept_graphs.iter() {
+            if !deferred.render_backing_room() {
+                break;
+            }
+            let pool = graph.pool();
+            if pool.vacant() || !render.pools.released(u32::from(pool.id()), pool.control_va()) {
+                continue;
+            }
+            if let Some(backing) = pool.vacate() {
+                deferred.defer_render_backing(backing);
+            }
+        }
         Ok(())
     }
     /// No graph is being built or grown.
