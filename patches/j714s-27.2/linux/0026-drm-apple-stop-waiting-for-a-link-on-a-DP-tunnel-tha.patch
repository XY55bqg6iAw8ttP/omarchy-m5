From 55c25aed764e477ddaa35a5e58582dbaf40a4412 Mon Sep 17 00:00:00 2001
From: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
Date: Sat, 14 Nov 2026 13:23:08 -0700
Subject: [PATCH 3/5] drm/apple: stop waiting for a link on a DP tunnel that
 went

A Thunderbolt 5 dock (Ugreen 10-in-1) on a J714s withdraws its first DP
tunnel about 190 ms after it is requested, right after DCP starts on it,
in about half of its first connects after boot or plug-in, and
re-advertises it about 1.4 s later. The connect then waits the full 2 s
for a link configuration that cannot come, while DCP retries the link
about every 500 ms. The release that follows the timeout can land in the
first milliseconds of such a retry, and then DCP never answers it:

  apple-dcp 2b2e00000.dcp: dcp_dptx_connect: timed out waiting for port 0 link configuration
  apple-dcp 2b2e00000.dcp: AFK[ep:2c]: AppleDCPDPTXRemotePort (chan:1) service call group 0 cmd 7 failed to complete: -110
  thunderbolt-apple-acio 381ac0000.acio: dpin0: display teardown failed: -110
  thunderbolt-apple-acio 381ac0000.acio: dpin0: DP tunnel setup failed: -110

The display stays dark, its pipeline held, until the dock is plugged in
again. Over 11 such connects, 4 of the 5 releases sent within 26 ms of a
retry went unanswered, and none of the 6 sent 97 ms or more after one.

Wait for the link in 50 ms slices, and ask the Thunderbolt glue between
them whether the tunnel is still requested. Once it is not, release the
display at once, well before DCP's first retry, so that the re-advertised
tunnel finds the pipeline free.

Tested on J714s with the dock on the right port: over 5 boots the dock
withdrew the first tunnel each time, the wait ended 17 to 47 ms later,
and all three displays came up on the re-advertised tunnels, with no
timeout and no -110.

Signed-off-by: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
---
 drivers/gpu/drm/apple/dcp.c | 71 ++++++++++++++++++++++++++++++++++---
 1 file changed, 67 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index fa771f5d7d99..908ffdb5521e 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -2069,6 +2069,63 @@ static int dcp_t8132_wait_teardown_answers(struct apple_dcp *dcp, u32 port,
  * With a @session, every step checks that it is still the live one, and a
  * revoked session returns -ESTALE without touching the new one's state.
  */
+/*
+ * Has the Thunderbolt DP tunnel this pipeline was handed been taken down?
+ * Its provider knows at once, while the detach that follows waits for the
+ * connect in progress on this pipeline.
+ */
+static bool dcp_tb_tunnel_withdrawn(struct apple_dcp *dcp)
+{
+	typeof(apple_dp_tunnel_binding_live) *live;
+	bool gone = false;
+
+	guard(mutex)(&dcp->tb_lock);
+	if (!dcp->tb_dpin_ctx)
+		return false;
+	live = symbol_get(apple_dp_tunnel_binding_live);
+	if (live) {
+		gone = !live(dcp->tb_dpin_ctx);
+		symbol_put(apple_dp_tunnel_binding_live);
+	}
+	return gone;
+}
+
+#define DCP_LINKCFG_POLL_MS	50
+
+/*
+ * Wait up to @timeout for DCP's link configuration of @port, returning what
+ * wait_for_completion_timeout() would. With @watch_tunnel, a Thunderbolt
+ * tunnel taken down meanwhile ends the wait at once and sets *@withdrawn:
+ * no link comes on it, and DCP keeps retrying it until released. A release
+ * that comes in the first milliseconds of such a retry can go unanswered
+ * for good, leaving the pipeline held, so release it as soon as it goes.
+ */
+static unsigned long dcp_dptx_wait_linkcfg(struct apple_dcp *dcp, u32 port,
+					   unsigned long timeout, bool watch_tunnel,
+					   bool *withdrawn)
+{
+	unsigned long deadline = jiffies + timeout;
+	long left;
+
+	*withdrawn = false;
+	if (!watch_tunnel)
+		return wait_for_completion_timeout(&dcp->dptxport[port].linkcfg_completion,
+						   timeout);
+	for (;;) {
+		left = (long)(deadline - jiffies);
+		if (left <= 0)
+			return 0;
+		if (wait_for_completion_timeout(&dcp->dptxport[port].linkcfg_completion,
+						min_t(unsigned long, left,
+						      msecs_to_jiffies(DCP_LINKCFG_POLL_MS))))
+			return max_t(long, (long)(deadline - jiffies), 1);
+		if (dcp_tb_tunnel_withdrawn(dcp)) {
+			*withdrawn = true;
+			return 0;
+		}
+	}
+}
+
 static int dcp_dptx_connect_raw(struct apple_dcp *dcp, u32 port, bool *retryable,
 				const struct dcp_fabric_session *session, bool cable,
 				bool recovery)
@@ -2076,7 +2133,7 @@ static int dcp_dptx_connect_raw(struct apple_dcp *dcp, u32 port, bool *retryable
 	/* T8122 dcpext: HPD only after the link wait, see dcp_ext_dptx_607() */
 	bool late_hpd = dcp_ext_dptx_607(dcp);
 	bool t8132 = dcp_is_t8132_ext(dcp);
-	bool compact;
+	bool compact, withdrawn;
 	unsigned long timeout;
 	u64 generation;
 	u8 dfp_port;
@@ -2224,12 +2281,18 @@ static int dcp_dptx_connect_raw(struct apple_dcp *dcp, u32 port, bool *retryable
 	}
 	timeout = dcp_uses_t6020_tunnel_flow(dcp) ?
 		  DPTX_TUNNEL_CONNECT_TIMEOUT : DPTX_CONNECT_TIMEOUT;
-	ret = wait_for_completion_timeout(&dcp->dptxport[port].linkcfg_completion,
-					  timeout);
+	ret = dcp_dptx_wait_linkcfg(dcp, port, timeout, !compact && !late_hpd,
+				    &withdrawn);
 	/* A revoked wait must not disconnect or publish readiness for a new session. */
 	if (!dcp_connect_session_valid(dcp, session, cable, recovery))
 		return -ESTALE;
-	if (!ret && compact) {
+	if (!ret && withdrawn) {
+		dev_info(dcp->dev,
+			 "dcp_dptx_connect: port %u: the DP tunnel went before link configuration\n",
+			 port);
+		ret = -ENOLINK;
+		goto out_withdraw;
+	} else if (!ret && compact) {
 		/* Without a sink the link is configured once one arrives. */
 		dev_dbg(dcp->dev,
 			"dcp_dptx_connect: no link configuration on port %u yet\n", port);
-- 
