From 5009149b747d57b9a8312b7763963a58563ef02b Mon Sep 17 00:00:00 2001
From: betizzel <betizzel@pm.me>
Date: Sun, 15 Nov 2026 16:01:30 -0600
Subject: [PATCH] phy: apple: atc-t6050: hold the DP-only PHY's domains through
 suspend-to-idle

"phy: apple: atc-t6050: keep the PHY's domains through suspend-to-idle"
holds a combo PHY's domains out of an s2idle transition, from the PM
notifier that combo_setup() registers. The DisplayPort-only PHY behind
the J714s HDMI converter (ATC3, apple,t6050-dp-phy) never registers it:
it has no sleep handling at all.

Its domains are ATC3's usb-aon, common and phymxwrap. The display
crossbar (38b24c000.mux) holds usb-aon and common from its probe on,
as it does ATC1's and ATC2's, so genpd's noirq suspend gates them once
their member devices have suspended, and nothing sets them up again at
an s2idle wake. The next HDMI hotplug's power-up then times out in its
first poll, and the DCP behind it crashes until a reboot. Seen on a
J714s on v272-11, lid closed with HDMI only: after twelve s2idle
attempts that each reached the noirq phase (each refused by pcie-apple
there, -EBUSY), the monitor dropped HPD and came back:

  apple-dcp 306e00000.dcp: DP2HDMI HPD irq, 500ms debounce: connected:1
  apple-t6050-dp-phy 38b000000.phy: bank39+4 timeout: 300 & 1 != 1
  apple-dcp 306e00000.dcp: RTKit: co-processor has crashed
  apple-dcp 306e00000.dcp: DCP has crashed
  apple-dcp 306e00000.dcp: a reboot is required to restore the display

HDMI had run at 2560x1080 since boot; the crash was its first power-up
after the domains had been through a noirq suspend.

Register the notifier for every T6050 PHY on combo_sleep_board(), in
the probe after combo_setup(), and give the DP-only PHY the s2idle hold
over its three domains. The deep-sleep branch (the always-on domain
kept through apple_sleep_usb_aon_keep(), which goes by a combo's port)
stays the combo's: the DP-only PHY skips it, at the prepare and at the
post-suspend.

Compile-tested only (gcc 16, W=1, the v272-12 config without Rust);
not run across a sleep yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/phy/apple/atc-t6050-combo.h | 39 ++++++++++++++++++++---------
 drivers/phy/apple/atc-t6050-dp.c    |  5 +++-
 2 files changed, 31 insertions(+), 13 deletions(-)

diff --git a/drivers/phy/apple/atc-t6050-combo.h b/drivers/phy/apple/atc-t6050-combo.h
index 4ff849abb..5684f4cd8 100644
--- a/drivers/phy/apple/atc-t6050-combo.h
+++ b/drivers/phy/apple/atc-t6050-combo.h
@@ -118,9 +118,10 @@ static void combo_pipe_fault(struct t6050_dp *dp, const char *what, int ret)
 /*
  * What the combo PHY gained for a deep sleep outside its sleep callbacks (a wrapper domain
  * still held at a stop is released, a safe state with a domain still held is stopped again,
- * the always-on domain's hold over the sleep) and its domains' hold over suspend-to-idle
- * are in force on the board they have run on, the J714s. On another T6050 board the stop,
- * the safe state and the probe are as before.
+ * the always-on domain's hold over the sleep) and the domains' hold over suspend-to-idle,
+ * of a combo PHY and of a DisplayPort-only one (the HDMI converter's), are in force on the
+ * board they have run on, the J714s. On another T6050 board the stop, the safe state and the
+ * probe are as before.
  */
 static bool combo_sleep_board(void)
 {
@@ -381,6 +382,11 @@ static void combo_resume(struct t6050_dp *dp)
  * genpd never counts them all suspended: each stays in its runtime state. The usb domain,
  * and with it the dwc3 and its DARTs, then stays on through s2idle, as dwc3-apple's
  * s2idle path, which keeps the host in place, expects.
+ *
+ * The DisplayPort-only PHY behind the HDMI converter (ATC3 on the J714s) has the same
+ * always-on and common domains held by the crossbar, and the same failure: after a
+ * suspend-to-idle, the next HDMI hotplug's power-up times out in the first poll (bank 39)
+ * and the DCP behind it crashes. It takes the same hold, over its three domains.
  */
 static void combo_s2idle_hold(struct t6050_dp *dp, bool hold)
 {
@@ -410,7 +416,7 @@ static int combo_pm_notify(struct notifier_block *nb, unsigned long action, void
 				combo_s2idle_hold(dp, true);
 			break;
 		}
-		if (dp->faulted || dp->aon_syscore ||
+		if (!dp->combo || dp->faulted || dp->aon_syscore ||
 		    dp->combo_mode == COMBO_SAFE || !dp->domain[0].active)
 			break;
 		if (!apple_sleep_usb_aon_keep(dp->port, true))
@@ -421,6 +427,8 @@ static int combo_pm_notify(struct notifier_block *nb, unsigned long action, void
 	case PM_POST_SUSPEND:
 		if (dp->s2idle_held)
 			combo_s2idle_hold(dp, false);
+		if (!dp->combo)
+			break;
 		apple_sleep_usb_aon_keep(dp->port, false);
 		if (dp->aon_syscore) {
 			dev_pm_syscore_device(dp->domain[0].dev, false);
@@ -440,6 +448,20 @@ static void combo_pm_notifier_remove(void *data)
 	unregister_pm_notifier(&dp->pm_nb);
 }
 
+/* The domains' hold over a system sleep, deep or s2idle: see combo_sleep_board(). */
+static int combo_pm_notifier_setup(struct t6050_dp *dp)
+{
+	int ret;
+
+	if (!combo_sleep_board())
+		return 0;
+	dp->pm_nb.notifier_call = combo_pm_notify;
+	ret = register_pm_notifier(&dp->pm_nb);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(dp->dev, combo_pm_notifier_remove, dp);
+}
+
 static int combo_usb2_mode(struct phy *phy, enum phy_mode mode, int submode)
 {
 	struct t6050_dp *dp = phy_get_drvdata(phy);
@@ -700,13 +722,6 @@ static int combo_setup(struct platform_device *pdev, struct t6050_dp *dp)
 			return PTR_ERR(dp->combo_phy[i]);
 		phy_set_drvdata(dp->combo_phy[i], dp);
 	}
-	/* The domains' hold over a system sleep, deep or s2idle: see combo_sleep_board(). */
-	if (!combo_sleep_board())
-		return 0;
-	dp->pm_nb.notifier_call = combo_pm_notify;
-	ret = register_pm_notifier(&dp->pm_nb);
-	if (ret)
-		return ret;
-	return devm_add_action_or_reset(dev, combo_pm_notifier_remove, dp);
+	return 0;
 }
 
diff --git a/drivers/phy/apple/atc-t6050-dp.c b/drivers/phy/apple/atc-t6050-dp.c
index 75fdf78c4..21a6356b8 100644
--- a/drivers/phy/apple/atc-t6050-dp.c
+++ b/drivers/phy/apple/atc-t6050-dp.c
@@ -129,7 +129,7 @@ struct t6050_dp {
 	bool dp_gates;
 	u8 tunnel_rate[ATC_DP_TUNNELS];
 	u8 tunnel_idle;		/* bit k - 1: clock k runs with no user, see below */
-	/* A combo PHY's system sleep. */
+	/* A system sleep: a combo PHY's, and the domains' hold over suspend-to-idle. */
 	u32 port;
 	struct notifier_block pm_nb;
 	enum combo_mode sleep_mode;	/* the mode the sleep's stop took down */
@@ -1098,6 +1098,9 @@ static int t6050_dp_probe(struct platform_device *pdev)
 		if (ret)
 			return ret;
 	}
+	ret = combo_pm_notifier_setup(dp);
+	if (ret)
+		return ret;
 	phy = devm_phy_create(dev, NULL, &t6050_dp_ops);
 	if (IS_ERR(phy))
 		return PTR_ERR(phy);
-- 
2.56.1

