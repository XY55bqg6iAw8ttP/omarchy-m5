From d085379655924278a4edfb716479b7c4c8883b2e Mon Sep 17 00:00:00 2001
From: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
Date: Sat, 14 Nov 2026 13:23:08 -0700
Subject: [PATCH 2/5] thunderbolt: apple: tell appledrm whether a DP tunnel is
 still requested

appledrm connects a DP tunnel's display from the DP IN adapter's ordered
worker and waits for DCP to configure the link. A tunnel that is taken
down meanwhile is detached only after that wait: the detach is queued
behind it. The adapter knows at once, when the tunnel is deactivated,
that the tunnel is no longer requested.

Export apple_dp_tunnel_binding_live() so that appledrm can ask, for the
binding it was handed, whether its tunnel is still requested. It takes
the adapter's lock, as the binding's set_active callback does.

Signed-off-by: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
---
 drivers/thunderbolt/apple.c         | 11 +++++++++++
 include/linux/soc/apple/dp-tunnel.h |  8 ++++++++
 2 files changed, 19 insertions(+)

diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index 3aa62de12e91..ab5fcec02a60 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -839,6 +839,17 @@ static int apple_dpin_dcp_set_active(void *data, bool active)
 	return ret;
 }
 
+bool apple_dp_tunnel_binding_live(void *data)
+{
+	const struct apple_dpin_binding *binding = data;
+	struct apple_dpin_ctx *c = binding->ctx;
+
+	guard(mutex)(&c->lock);
+	return c->state.alive &&
+	       apple_dpin_token_access(&c->tokens, binding->generation);
+}
+EXPORT_SYMBOL_GPL(apple_dp_tunnel_binding_live);
+
 static bool apple_dpin_provider_get(void *data)
 {
 	struct apple_dpin_binding *binding = data;
diff --git a/include/linux/soc/apple/dp-tunnel.h b/include/linux/soc/apple/dp-tunnel.h
index 034a74b852eb..09afceeda700 100644
--- a/include/linux/soc/apple/dp-tunnel.h
+++ b/include/linux/soc/apple/dp-tunnel.h
@@ -38,6 +38,14 @@ int apple_dcp_tb_dp_tunnel(struct device_node *connector_np, unsigned int dpin,
 			   u64 generation, bool active,
 			   int (*set_active)(void *binding, bool active), void *binding);
 
+/*
+ * Thunderbolt glue: is the tunnel handed to appledrm with @binding still
+ * requested? It is not from the moment the tunnel is deactivated, before
+ * the detach that follows reaches appledrm. Takes the DP IN adapter's lock,
+ * as @set_active does; may sleep.
+ */
+bool apple_dp_tunnel_binding_live(void *binding);
+
 /* The sink raised IRQ_HPD on the tunnel's DP IN adapter. */
 #define APPLE_DP_TUNNEL_IRQ_HPD		BIT(0)
 /* The HPD level of the tunnel's DP IN adapter changed to @hpd. */
