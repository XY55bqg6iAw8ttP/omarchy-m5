From cd54949d2b72ad22ef565e578be4481ea2ae70bc Mon Sep 17 00:00:00 2001
From: DjDeveloperr <hey@djdev.me>
Date: Sat, 14 Nov 2026 09:15:36 -0500
Subject: [PATCH] arm64: dts: apple: t6050-j714s: Enforce the PMP's fast-die
 effort

The PMP runs a control loop on the die's hot-spot sensors and publishes
an effort for each CPU cluster in its FAST-DIE-CE range. The T6050 trees
only asserted apple,firmware-managed-thermal, on the assumption that the
firmware also lowers the clusters' performance state. It does not: under
a sustained all-core load on J714s the effort reaches its maximum while
every cluster keeps its top state. The dies then run above the
firmware's target, and the CPUs get less work done than when the limit
is enforced.

Give J714s's three clusters apple,fast-die-effort, in the order of the
ADT's fast-die-ctrl-ce-map (M0, M1, P), as the T6041 and T8140 trees do.
apple-soc-cpufreq then turns the effort into a frequency limit. Reword
the binding and the T6050 base comment to match: the firmware keeps
voltage and PLL control, but not the throttling. Other T6050 boards are
not qualified yet.

Signed-off-by: Diljit Singh <hey@djdev.me>
---
 .../cpufreq/apple,cluster-cpufreq.yaml        | 12 ++++++-----
 arch/arm64/boot/dts/apple/t6050-base.dtsi     | 10 ++++++----
 arch/arm64/boot/dts/apple/t6050-j714s.dts     | 20 +++++++++++++++++++
 3 files changed, 33 insertions(+), 9 deletions(-)

diff --git a/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml b/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
index b7ed80708377..85acb1dcd6d9 100644
--- a/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
+++ b/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
@@ -65,16 +65,18 @@ properties:
       - items:
           - description: PMP report region
           - description: Cluster lane (0 for E, 1 for P on T8140; 0 for
-              E, 1 for P0, 2 for P1 on T6041)
+              E, 1 for P0, 2 for P1 on T6041; 0 for M0, 1 for M1, 2 for P
+              on T6050)
             enum: [0, 1, 2]
 
   apple,firmware-managed-thermal:
     type: boolean
     description:
-      The boot loader leaves the cluster's thermal limiting with the
-      firmware, which keeps the throttling, voltage and PLL control for the
-      whole time Linux runs. The T6050 driver registers DVFS only when this
-      is present.
+      The boot loader leaves the cluster's voltage and PLL control with the
+      firmware for the whole time Linux runs. The firmware does not lower
+      the requested performance state itself; where it publishes an effort,
+      apple,fast-die-effort lets the OS enforce it. The T6050 driver
+      registers DVFS only when this is present.
 
   '#performance-domain-cells':
     const: 0
diff --git a/arch/arm64/boot/dts/apple/t6050-base.dtsi b/arch/arm64/boot/dts/apple/t6050-base.dtsi
index dfa99f92f41f..471e849a8f46 100644
--- a/arch/arm64/boot/dts/apple/t6050-base.dtsi
+++ b/arch/arm64/boot/dts/apple/t6050-base.dtsi
@@ -97,10 +97,12 @@ cpus {
 	 * (measured on J775D: every state's clock from a dependent-add chain). iBoot leaves M cluster
 	 * 0 of each die in state 6 (2652 MHz), the other clusters in state 2.
 	 *
-	 * Bring-up: the clusters' controllers (t6050-dieX.dtsi) assert apple,firmware-managed-thermal,
-	 * which the T6050 profile requires, before that ownership is qualified on this boot chain (no
-	 * Linux PMP driver runs; the SMC drives the fans). A qualification settles it: an all-core
-	 * load at the top states, watching TCMb, the fans and the measured clock.
+	 * The clusters' controllers (t6050-dieX.dtsi) assert apple,firmware-managed-thermal, which the
+	 * T6050 profile requires: the firmware keeps the voltage and PLL control. It does not lower a
+	 * cluster's requested state on its own: on J714s, under a sustained all-core load, the PMP's
+	 * fast-die effort reaches its maximum while the clusters stay at their top state, so boards
+	 * whose PMP runs give each cluster apple,fast-die-effort (t6050-j714s.dts). Other boards are
+	 * not qualified yet.
 	 */
 	mcluster_opp: opp-table-mcluster {
 		compatible = "operating-points-v2";
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s.dts b/arch/arm64/boot/dts/apple/t6050-j714s.dts
index 33f076f29622..86ad24d023d5 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714s.dts
@@ -465,6 +465,26 @@ &pmp0_report {
 	status = "okay";
 };
 
+/*
+ * The PMP runs a control loop on the die's hot-spot sensors and publishes an effort for each
+ * cluster in its FAST-DIE-CE range, in the order of the ADT's fast-die-ctrl-ce-map: MACC0, MACC1
+ * and PACC_ANE (the P cluster). The OS enforces it as a frequency limit; the ADT's CLPC node lists
+ * the same range among its ptd-ranges. Without the limit the clusters keep their top state while
+ * the effort sits at its maximum under a sustained all-core load. Until the PMP reports that it
+ * runs (also on a boot without the PMP driver), cpufreq holds each cluster at its fallback limit.
+ */
+&cpufreq_mc0 {
+	apple,fast-die-effort = <&pmp0_report 0>;
+};
+
+&cpufreq_mc1 {
+	apple,fast-die-effort = <&pmp0_report 1>;
+};
+
+&cpufreq_pc {
+	apple,fast-die-effort = <&pmp0_report 2>;
+};
+
 &pmc {
 	/* PMP, CLPC and AP agents, once the PMP runs */
 	apple,static-voters = <0 1 3>;
-- 
2.56.0

